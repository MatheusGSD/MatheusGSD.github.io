---
// Coluna fixa: nome, bio, menu e contatos. No celular vira cabeçalho.
import { SITE, contagens } from "../site";

interface Props {
  atual: "tudo" | "projeto" | "texto" | "sobre";
}
const { atual } = Astro.props;
const n = await contagens();
const menu = [
  { nome: "Projetos", href: "/projetos/", nota: String(n.projetos), k: "projeto" },
  { nome: "Textos", href: "/textos/", nota: String(n.textos), k: "texto" },
  { nome: "Sobre", href: "/sobre/", nota: "→", k: "sobre" },
];
---
<aside class="lado">
  <a class="nome" href="/">Matheus<br>Dalmolin</a>
  <p class="bio">{SITE.bio}</p>
  <nav aria-label="Seções">
    {menu.map((m) => (
      <a href={m.href} aria-current={atual === m.k ? "page" : undefined}>{m.nome} <span>{m.nota}</span></a>
    ))}
  </nav>
  <div class="contatos">
    {SITE.contatos.map((c) => <a href={c.url} rel={c.url.startsWith("http") ? "me" : undefined}>{c.nome}</a>)}
  </div>
</aside>
